# Kopirajte v .env in vpišite svoje ključe. Datoteka .env NI v gitu.
# Vsi ključi so neobvezni – brez njih sistem dela lokalno (ocena časov, pravila).

# Usmerjanje s prometom (oznaka "natančno") – Routing API
TOMTOM_API_KEY=
# Prikaz karte in prometa (Map Display API + Traffic API); če ni nastavljen, se uporabi TOMTOM_API_KEY
TOMTOM_MAP_KEY=
# Besedilo atribucije na karti (preverite pogoje ponudnika)
# AID_KARTA_ATRIBUCIJA=
# Rezervni izračun poti
ORS_API_KEY=
OSRM_URL=

# AI poslušalec v oblaku
ANTHROPIC_API_KEY=
# AID_LLM_MODEL=claude-opus-5-5

# Lokalni LLM (rezerva)
OLLAMA_URL=

# Dostop do /interno/zdravje
AID_SKRBNIK_ZETON=

# Dispečerji (ime:geslo;ime2:geslo2). Demo računa iz scenarija izklopite z AID_DISPECER_DEMO=0.
AID_DISPECERJI=
# AID_DISPECER_DEMO=0
# Skrivnosti za podpis žetonov. Če nista nastavljeni, ju zazeni.py ustvari enkrat (podatki/.skrivnosti.json).
AID_DISPECER_SKRIVNOST=
AID_VOZNIK_SKRIVNOST=
# Alarm tudi za enote brez naprave v izmeni (privzeto izklopljeno)
# AID_ESKALACIJA_BREZ_NAPRAVE=1
# Dokumentacija API na /interno/docs (privzeto izklopljena)
# AID_DOCS=1
